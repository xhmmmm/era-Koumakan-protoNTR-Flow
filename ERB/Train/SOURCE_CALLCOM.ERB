@CALL_COM(ARG)
;六九式
IF (TEQUIP:ARG:口 == 1 || TEQUIP:ARG:口 == 2) && (TEQUIP:ARG:阴茎 == 4 || TEQUIP:ARG:阴蒂 == 4) && (SELECTCOM == 1 || SELECTCOM == 81)
	TFLAG:特殊COM = 1
	;岩清水
ELSEIF TEQUIP:ARG:羞耻PLAY && SELECTCOM == 1
	TFLAG:特殊COM = 2
	;G点刺激
ELSEIF SELECTCOM == 3 && PREVCOM == SELECTCOM && TFLAG:前ターンのTARGET交代 == ARG
	TFLAG:特殊COM = 3
	;乱れ牡丹
ELSEIF TEQUIP:ARG:羞耻PLAY && SELECTCOM == 68
	TFLAG:特殊COM = 4
	;手淫口交
ELSEIF (TEQUIP:ARG:指 == 1 && TEQUIP:ARG:口２ == 1) || (TEQUIP:ARG:口 == 1 && TEQUIP:ARG:指２ == 1)
	;フェラ-手淫
	IF TEQUIP:ARG:指 == 1
		TFLAG:SOURCEなどに影響しないSELECTCOMの分岐 = 0
		;手淫-フェラ
	ELSE
		TFLAG:SOURCEなどに影響しないSELECTCOMの分岐 = 1
	ENDIF
	TFLAG:特殊COM = 5
	;母乳飲み
ELSEIF SELECTCOM == 10 && TALENT:ARG:泌乳体质
	IF TEQUIP:ARG:指２ == 1
		TFLAG:特殊COM = 16
	ELSE
		TFLAG:特殊COM = 14
	ENDIF
	;插入Ｇ点刺激、子宮口責め、交互插入
ELSEIF (SELECTCOM == 60 || SELECTCOM == 61 || SELECTCOM == 65 || SELECTCOM == 67 || SELECTCOM == 68) 
	IF TEQUIP:ARG:体位 == TEQUIP:ARG:体位２ && TFLAG:前ターンのTARGET交代 == TARGET && TEQUIP:ARG:膣２ == 1
		IF SELECTCOM == 65 || RAND:2
			TFLAG:特殊COM = 7
		ELSE
			TFLAG:特殊COM = 6
		ENDIF
	ENDIF
	;交互插入
	IF TEQUIP:ARG:膣 == 1 && (MASTER_POSE(6,1,1) && MASTER_POSE(6,1,1) != ARG)
		TFLAG:特殊COM = 13
	ENDIF
	;六九式乳交
ELSEIF TEQUIP:ARG:胸 == 1 && (TEQUIP:ARG:阴茎 == 4 || TEQUIP:ARG:阴蒂 == 4) && (SELECTCOM == 1 || SELECTCOM == 82)
	TFLAG:特殊COM = 8
	;双人口交
ELSEIF TEQUIP:ARG:口 == 1 && (MASTER_POSE(4,1,1) && MASTER_POSE(4,1,1) != ARG )
	TFLAG:特殊COM = 9
	;双人素股
ELSEIF TEQUIP:ARG:阴蒂 == 1 && (MASTER_POSE(2,1,1) && MASTER_POSE(2,1,1) != ARG )
	TFLAG:特殊COM = 10
	;双人乳交
ELSEIF TEQUIP:ARG:胸 == 1 && (MASTER_POSE(5,1,1) && MASTER_POSE(5,1,1) != ARG )
	TFLAG:特殊COM = 11
	;乳夹口交
ELSEIF (TEQUIP:ARG:胸 == 1 && TEQUIP:ARG:口２ == 1) || (TEQUIP:ARG:口 == 1 && TEQUIP:ARG:胸２ == 1)
	TFLAG:特殊COM = 12
	;授乳
ELSEIF SELECTCOM == 11 && TALENT:MASTER:泌乳体质
	TFLAG:特殊COM = 15
	;授乳手コキ
ELSEIF TEQUIP:ARG:指２ == 1 && SELECTCOM == 10
	TFLAG:特殊COM = 16
ENDIF

RESULT = 0
IF TFLAG:特殊COM
	CALLFORM COM_ABLE{500 + TFLAG:特殊COM}
	IF RESULT
		TRYCALLFORM CAN_SCOM{TFLAG:特殊COM}(1)
		IF RESULT
			TRYCCALLFORM CAN_SCOM{TFLAG:特殊COM}
			CATCH
				PRINTFORML %STR:(1500 + TFLAG:特殊COM)%
			ENDCATCH
			STR:0 = %STR:(1500 + TFLAG:特殊COM)%
			TRYCALLFORM SCOM{TFLAG:特殊COM}
		ENDIF
	ENDIF
ENDIF
SIF RESULT
	RETURN RESULT
TFLAG:特殊COM = 0
LOCALS = %STR:(1000 + SELECTCOM)%

TRYCCALLFORM CAN_COM{SELECTCOM}
CATCH
	PRINTFORML %LOCALS%
ENDCATCH
STR:0 = %LOCALS%
TRYCALLFORM COM{SELECTCOM}
RETURN RESULT
