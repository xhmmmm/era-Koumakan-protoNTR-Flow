;-------------------------------------------------
;润滑剂
;特殊コマンド
;-------------------------------------------------
@COM180
ITEM:润滑剂 -= 1
;自動補充
IF !ITEM:润滑剂 && MONEY >= 200 && FLAG:作者未命名1001
	MONEY -= 200
	ITEM:润滑剂 ++
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:行為者 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、气力
DOWNBASE:体力 += 0
DOWNBASE:气力 += 0

SOURCE:液体 = 5000
SOURCE:露出 = 100

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF HETEROSEX(TARGET,PLAYER)
	EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
ENDIF
CALL 确认乳头颜色(TARGET)
CALL 确认乳头大小(TARGET)
CALL 确认小穴颜色(TARGET)
CALL 确认小穴松弛度(TARGET)
CALL 确认肛门颜色(TARGET)
CALL 确认肛门松弛度(TARGET)
RETURN 1
